{
  "schema": "nf-vocabularies/1",
  "note": "词表登记册（机制借鉴 SKOS 的 ConceptScheme：概念用标识符 + 标签 + 层级/映射管理）。NF 的词表此前散在代码常量与 JSON 字段里，漂移只能靠人记；本册把它们集中声明，并用 probe 指回真源逐项比对——真源变了而册子没跟，门禁即 FAIL。probe.kind=literal 表示该词表以本册为准（无代码真源）。aliases 收录同义/历史写法（SKOS altLabel 思路），只用于读，不参与判定。",
  "probe_kinds": ["python_attr", "json_path", "literal"],
  "status_vocabulary": ["active", "deprecated"],
  "schemes": [
    {"id": "doc-kinds", "title": "文档四型（Diátaxis）", "status": "active",
     "probe": {"kind": "python_attr", "module": "core.doc_hygiene", "attr": "KINDS"},
     "values": ["tutorial", "how-to", "reference", "explanation"], "aliases": []},
    {"id": "knowledge-authority", "title": "知识源权威级", "status": "active",
     "probe": {"kind": "json_path", "file": "protocol/knowledge_sources.json",
               "path": "authority_vocabulary"},
     "values": ["contract", "reference"], "aliases": ["契约级", "参考级"]},
    {"id": "knowledge-kind", "title": "知识源形态", "status": "active",
     "probe": {"kind": "json_path", "file": "protocol/knowledge_sources.json",
               "path": "kind_vocabulary"},
     "values": ["local-compiled", "external-retrieval"], "aliases": ["编译层", "检索层"]},
    {"id": "knowledge-visibility", "title": "知识可见性（认知裁剪秩）", "status": "active",
     "probe": {"kind": "json_path", "file": "protocol/knowledge_sources.json",
               "path": "visibility_vocabulary"},
     "values": ["public", "internal", "restricted"], "aliases": ["公开", "内部", "受限"]},
    {"id": "promotion-tiers", "title": "晋升证据档", "status": "active",
     "probe": {"kind": "json_path", "file": "protocol/knowledge_sources.json",
               "path": "promotion.evidence_tiers"},
     "values": ["machine-checkable", "reproducible", "externally-attestable"], "aliases": []},
    {"id": "promotion-triggers", "title": "晋升触发条件", "status": "active",
     "probe": {"kind": "json_path", "file": "protocol/knowledge_sources.json",
               "path": "promotion.triggers"},
     "values": ["reuse-frequency", "author-mark", "machine-check-pass"], "aliases": []},
    {"id": "assertion-severity", "title": "断言严重级", "status": "active",
     "probe": {"kind": "json_path", "file": "protocol/assertions.json",
               "path": "severity_vocabulary"},
     "values": ["fail", "warn"], "aliases": []},
    {"id": "assertion-kinds", "title": "断言 kind（封闭集）", "status": "active",
     "probe": {"kind": "python_attr", "module": "core.assertions", "attr": "KINDS"},
     "values": ["regex_absent", "regex_present", "count_at_least", "json_value"],
     "aliases": []},
    {"id": "rfc-status", "title": "协议件状态", "status": "active",
     "probe": {"kind": "json_path", "file": "protocol/rfc_index.json",
               "path": "status_vocabulary"},
     "values": ["Active", "Superseded", "Deprecated", "Experimental"], "aliases": []},
    {"id": "rfc-category", "title": "协议件类别", "status": "active",
     "probe": {"kind": "python_attr", "module": "core.rfc", "attr": "CATEGORIES"},
     "values": ["Standards Track", "Informational", "Experimental", "Process"],
     "aliases": []},
    {"id": "pattern-status", "title": "实践包状态", "status": "active",
     "probe": {"kind": "python_attr", "module": "core.patterns", "attr": "STATUSES"},
     "values": ["active", "deprecated"], "aliases": []},
    {"id": "machine-contract-keys", "title": "模块机读契约键（九键必填 + 可选扩展）",
     "status": "active",
     "probe": {"kind": "json_path", "file": "protocol/schema/contract.schema.json",
               "path": "properties"},
     "values": ["schema", "conformance", "id", "name", "category", "layer", "inputs",
                "outputs", "events", "interfaces", "io_types", "tool_face", "world_model"],
     "aliases": []}
  ]
}
