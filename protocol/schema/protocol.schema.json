{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "protocol.schema.json",
  "title": "社区包协议声明 protocol.yaml（01 §6.1）",
  "description": "community/*/protocol.yaml 的 IDL 定义；R1/R2/R3 机读载体。",
  "type": "object",
  "required": ["protocol", "package"],
  "properties": {
    "protocol": {
      "type": "object",
      "required": ["schema_version"],
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": ["1", "2"],
          "description": "v1 无 references；v2 起支持 references（组合引用）"
        }
      }
    },
    "package": {
      "type": "object",
      "required": ["id", "name", "pipeline", "module_id_range", "categories", "dependencies", "modules", "assets", "mount_layers"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "conformance": {
          "type": "string",
          "enum": ["L1", "L2", "L3"],
          "description": "协议包一致性分级声明（01 §1.2）；在册包 = L2"
        },
        "pipeline": { "type": "string", "pattern": "^P[0-9]{2}$" },
        "module_id_range": {
          "type": "array",
          "items": { "type": "string", "pattern": "^([^:]*:)?M[0-9]{2}$" }
        },
        "categories": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "dependencies": {
          "type": "object",
          "required": ["core_only", "core_modules", "cross_package"],
          "properties": {
            "core_only": { "type": "boolean", "enum": [true] },
            "core_modules": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "cross_package": {
              "type": "array",
              "maxItems": 0,
              "description": "deprecated 兼容字段（恒空）；references 为唯一跨包引用通道"
            }
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_package", "module_id", "source_schema_version", "asset_readonly"],
            "properties": {
              "source_package": { "type": "string", "minLength": 1 },
              "module_id": { "type": "string", "pattern": "^([^:]*:)?M[0-9]{2}$" },
              "source_schema_version": { "type": "string", "enum": ["1", "2"] },
              "asset_readonly": { "type": "boolean" }
            }
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "desc"],
            "properties": {
              "id": { "type": "string", "pattern": "^([^:]*:)?M[0-9]{2}$" },
              "desc": { "type": "string", "minLength": 1 }
            }
          }
        },
        "assets": {
          "type": "object",
          "required": ["count", "readme"],
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "readme": { "type": "string", "minLength": 1 }
          }
        },
        "mount_layers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["default", "available"],
            "properties": {
              "default": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "available": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          },
          "description": "层名 → {default[], available[]}，对齐 02 §5 挂载点"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
