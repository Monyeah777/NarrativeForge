{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset.schema.json",
  "title": "资产台账条目（05 provenance.json assets[]）",
  "description": "05_资产库/provenance.json assets[] 单条的 IDL 定义（S2 台账机读真相）。",
  "type": "object",
  "required": ["file", "key", "source", "module", "version", "status", "added"],
  "properties": {
    "file": { "type": "string", "minLength": 1 },
    "key": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
    "source": { "type": "string", "minLength": 1 },
    "module": { "type": "string", "pattern": "^([^:]*:)?M[0-9]{2}$" },
    "version": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["active", "deprecated", "retired"] },
    "added": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  },
  "additionalProperties": true
}
