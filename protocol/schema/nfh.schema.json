{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nfh.schema.json",
  "title": "NFH 认知引擎头（header-only）",
  "description": "认知引擎头声明：只放符号声明与真源 path 指针，不放本体实现（防膨胀成第二内核）。符号真源只读引用 protocol/module_signatures.json（不复制其内容）。版本槽独立：nfh_version 与 protocol.schema_version 解耦，首引走 additive。校验接入面：当前由 check28 全量件扫描的元校验 + 子集关键字白名单覆盖；实例配对校验待 NFH 落地阶段接入（届时按 $id 文件名式取件）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "nfh_version", "id", "title", "kind", "symbols"],
  "properties": {
    "schema": {
      "type": "string",
      "enum": ["nf-nfh/1"]
    },
    "nfh_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^nfh:[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": ["header"]
    },
    "symbol_source": {
      "type": "string",
      "enum": ["protocol/module_signatures.json"]
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "module"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "kind": {
            "type": "string",
            "enum": ["function", "type", "constant"]
          },
          "module": {
            "type": "string",
            "pattern": "^([^:]*:)?M[0-9]{2,}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
