{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipeline.schema.json",
  "title": "管线声明 Pipeline（01 §2）",
  "description": "管线文档内 Pipeline yaml 围栏的 IDL 定义（id/structure/flow/layers）。",
  "type": "object",
  "required": ["id", "name", "structure", "layers"],
  "properties": {
    "id": { "type": "string", "pattern": "^P[0-9]{2}$" },
    "name": { "type": "string", "minLength": 1 },
    "structure": {
      "type": "object",
      "required": ["type", "flow"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["linear", "loop", "branch", "fold", "parallel", "nested", "custom", "techdoc"],
          "description": "已知装配子型；techdoc = 技术文档线特化（P90/P06，07 §1 认证装配，值域扩展见 01 §2）"
        },
        "flow": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string", "pattern": "^P[0-9]{2}$" },
              "to": { "type": "string", "pattern": "^P[0-9]{2}$" },
              "condition": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "optional", "default_modules", "allowed_modules"],
        "properties": {
          "id": { "type": "string", "pattern": "^P[0-9]{2}$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "optional": { "type": "boolean" },
          "default_modules": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "allowed_modules": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "pattern": "^P[0-9]{2}$" },
          "to": { "type": "string", "pattern": "^P[0-9]{2}$" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": true
}
