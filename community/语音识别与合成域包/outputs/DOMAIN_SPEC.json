      "anchor_kind": "paper",
      "anchor_status": 200,
      "standard_ref": "w3c-webaudio",
      "standard_why": "关键词「音频|语音|声学|音乐|歌声」命中",
      "standards": [
        {
          "ref": "w3c-webaudio",
          "role": "primary",
          "why": "关键词「音频|语音|声学|音乐|歌声」命中",
          "layer": "form",
          "body": "W3C",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": []
        },
        {
          "ref": "ietf-json-schema",
          "role": "support",
          "why": "A 段载体锚（轮换 0；与主锚异层）",
          "layer": "data",
          "body": "IETF/JSON Schema",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "ietf-json"
          ]
        }
      ],
      "check": "声明 acoustic_frontend（帧长/帧移 ms）、token_unit（char|bpe|word）、decoding（greedy|beam+LM）三项。",
      "pitfall": "用不同语言模型融合强度比较 WER；前端帧移未记录导致流式与离线数字不可比。"
    },
    {
