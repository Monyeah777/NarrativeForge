          "ref": "onnx",
          "role": "primary",
          "why": "A 段默认绑定（轮换 2）",
          "layer": "iface",
          "body": "Linux Foundation",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "protobuf"
          ]
        },
        {
          "ref": "vega-lite",
          "role": "support",
          "why": "A 段载体锚（轮换 2；与主锚异层）",
          "layer": "form",
          "body": "Vega",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "ietf-json-schema"
          ]
        }
      ],
      "check": "声明 num_speakers（已知|自动）、clustering_threshold、metric（DER|EER）+ 评分帧长与主说话人定义。",
      "pitfall": "重叠语音不显式声明（collar 处理不同）导致 DER 不可比；说话人数假设不同直接比 EER。"
    },
