      "standards": [
        {
          "ref": "ietf-json-schema",
          "role": "primary",
          "why": "A 段默认绑定（轮换 0）",
          "layer": "data",
          "body": "IETF/JSON Schema",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "ietf-json"
          ]
        },
        {
          "ref": "vega-lite",
          "role": "support",
          "why": "A 段载体锚（轮换 1；与主锚异层）",
          "layer": "form",
          "body": "Vega",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
