    },
    {
      "id": "A08-11",
      "name": "骨骼绑定与动画",
      "definition": "骨骼绑定与动画的口径：骨骼层级、蒙皮权重与动画重定向误差。",
      "anchor": "https://arxiv.org/abs/1904.05866",
      "anchor_kind": "paper",
      "anchor_status": 200,
      "standard_ref": "mlcommons-bench",
      "standard_why": "A 段默认绑定（轮换 1）",
      "standards": [
        {
          "ref": "mlcommons-bench",
          "role": "primary",
          "why": "A 段默认绑定（轮换 1）",
          "layer": "eng",
          "body": "MLCommons",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": []
        },
        {
          "ref": "ietf-json-schema",
          "role": "support",
          "why": "A 段载体锚（轮换 0；与主锚异层）",
          "layer": "data",
          "body": "IETF/JSON Schema",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "ietf-json"
          ]
        }
