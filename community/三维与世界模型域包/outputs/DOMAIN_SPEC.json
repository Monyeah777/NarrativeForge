  "domain": "三维与世界模型",
  "section": "A · 模型与能力",
  "anchors_verified_on": "2026-09-22",
  "standard_anchors_verified_on": "2026-09-24",
  "metric_family": "regression",
  "content_tier": "authored",
  "data_authenticity": {
    "standard_bindings": 24,
    "in_catalog_ratio": 1.0,
    "reachable_ratio": 1.0,
    "probe_evidence_ratio": 1.0,
    "anchor_probed_ratio": 1.0,
    "score": 1.0,
