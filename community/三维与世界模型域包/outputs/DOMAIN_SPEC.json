      "id": "A08-10",
      "name": "3D 资产格式与管线",
      "definition": "3D 资产格式与管线的口径：格式（glTF/USD/FBX）、坐标系、单位与压缩策略。",
      "anchor": "https://www.khronos.org/gltf/",
      "anchor_kind": "spec",
      "anchor_status": 200,
      "standard_ref": "ietf-json-schema",
