  "subdivisions": [
    {
      "id": "A08-01",
      "name": "三维重建与辐射场",
      "definition": "三维重建与辐射场的口径：输入视图数、坐标约定、指标（PSNR/SSIM/LPIPS）与视角划分。",
      "anchor": "https://arxiv.org/abs/2003.08934",
      "anchor_kind": "paper",
      "anchor_status": 200,
      "standard_ref": "opengeospatial",
      "standard_why": "关键词「地理|遥感|地图|空间|三维|点云」命中",
      "standards": [
        {
          "ref": "opengeospatial",
          "role": "primary",
          "why": "关键词「地理|遥感|地图|空间|三维|点云」命中",
          "layer": "data",
          "body": "OGC",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": []
        },
        {
          "ref": "vega-lite",
          "role": "support",
          "why": "A 段载体锚（轮换 2；与主锚异层）",
          "layer": "form",
          "body": "Vega",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "ietf-json-schema"
          ]
        }
      ],
      "check": "声明 views（训练/测试视角数）、coord_system（右手/左手 + 上轴）与 metric（PSNR/SSIM/LPIPS + 下采样口径）。",
      "pitfall": "测试视角与训练视角重叠（虚高）；分辨率与下采样口径不同直接比 PSNR。"
    },
    {
      "id": "A08-02",
      "name": "点云处理",
      "definition": "点云处理的口径：点云来源（扫描/生成）、采样密度与旋转平移不变性设定。",
      "anchor": "https://arxiv.org/abs/1612.00593",
      "anchor_kind": "paper",
      "anchor_status": 200,
      "standard_ref": "opengeospatial",
      "standard_why": "关键词「地理|遥感|地图|空间|三维|点云」命中",
      "standards": [
        {
          "ref": "opengeospatial",
          "role": "primary",
          "why": "关键词「地理|遥感|地图|空间|三维|点云」命中",
          "layer": "data",
          "body": "OGC",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": []
        },
        {
          "ref": "vega-lite",
          "role": "support",
          "why": "A 段载体锚（轮换 2；与主锚异层）",
          "layer": "form",
          "body": "Vega",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "ietf-json-schema"
          ]
        }
      ],
      "check": "声明 source（lidar|rgbd|generated）、density（点/平方米或总点数）与 invariance（旋转|平移|尺度 是否要求）。",
      "pitfall": "训练/测试采样密度不同；宣称旋转不变却未做旋转增强测试。"
    },
    {
      "id": "A08-03",
      "name": "纹理与材质生成",
      "definition": "纹理与材质生成的口径：材质表示（PBR 通道）、分辨率与光照一致性要求。",
      "anchor": "https://arxiv.org/abs/2201.05989",
      "anchor_kind": "paper",
      "anchor_status": 200,
      "standard_ref": "onnx",
      "standard_why": "A 段默认绑定（轮换 2）",
      "standards": [
        {
          "ref": "onnx",
          "role": "primary",
          "why": "A 段默认绑定（轮换 2）",
          "layer": "iface",
          "body": "Linux Foundation",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "protobuf"
          ]
        },
        {
          "ref": "vega-lite",
          "role": "support",
          "why": "A 段载体锚（轮换 2；与主锚异层）",
          "layer": "form",
          "body": "Vega",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "ietf-json-schema"
          ]
        }
      ],
      "check": "声明 pbr_channels（albedo/normal/roughness/metallic 等）、texture_resolution 与 lighting_consistency（是否做重光照检验）。",
      "pitfall": "只有 albedo 却宣称材质完整；生成纹理烘焙进光照（不可重光照）。"
    },
    {
      "id": "A08-04",
      "name": "文生 3D 资产",
      "definition": "文生 3D 资产的口径：表示形式（网格/高斯/隐式）、面数与多视角一致性判据。",
      "anchor": "https://arxiv.org/abs/2209.14988",
      "anchor_kind": "paper",
      "anchor_status": 200,
      "standard_ref": "ietf-json-schema",
      "standard_why": "A 段默认绑定（轮换 0）",
      "standards": [
        {
          "ref": "ietf-json-schema",
          "role": "primary",
          "why": "A 段默认绑定（轮换 0）",
          "layer": "data",
          "body": "IETF/JSON Schema",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "ietf-json"
          ]
        },
        {
          "ref": "w3c-prov-o",
          "role": "support",
          "why": "A 段载体锚（轮换 3；与主锚异层）",
          "layer": "gov",
          "body": "W3C",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "rdf11"
          ]
        }
      ],
      "check": "声明 representation（mesh|gaussian|implicit）、face_count（或点数）与 multiview_consistency（一致性指标 + 采样视角数）。",
      "pitfall": "只展示单视角好看；面数不声明导致不可用于下游管线。"
    },
    {
      "id": "A08-05",
      "name": "场景生成与布局",
      "definition": "场景生成与布局的口径：房间类型 / 布局约束、可通行性检查与物理合理性。",
      "anchor": "https://arxiv.org/abs/1702.04405",
      "anchor_kind": "paper",
      "anchor_status": 200,
      "standard_ref": "mlcommons-bench",
      "standard_why": "A 段默认绑定（轮换 1）",
      "standards": [
        {
          "ref": "mlcommons-bench",
          "role": "primary",
          "why": "A 段默认绑定（轮换 1）",
          "layer": "eng",
          "body": "MLCommons",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": []
        },
        {
          "ref": "w3c-prov-o",
          "role": "support",
          "why": "A 段载体锚（轮换 4；与主锚异层）",
          "layer": "gov",
          "body": "W3C",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "rdf11"
          ]
        }
      ],
      "check": "声明 room_types、constraints（可通行/支撑面/无穿插）与 physics_check（碰撞检测是否执行）。",
      "pitfall": "生成结果物体穿插或悬空；无通行性检查导致不可用。"
    },
    {
      "id": "A08-06",
      "name": "物理仿真与碰撞",
      "definition": "物理仿真与碰撞的口径：求解器、时间步长、接触模型与稳定性判据。",
      "anchor": "https://mitsuba.readthedocs.io/",
      "anchor_kind": "doc",
      "anchor_status": 200,
      "standard_ref": "onnx",
      "standard_why": "A 段默认绑定（轮换 2）",
      "standards": [
        {
          "ref": "onnx",
          "role": "primary",
          "why": "A 段默认绑定（轮换 2）",
          "layer": "iface",
          "body": "Linux Foundation",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "protobuf"
          ]
        },
        {
          "ref": "ietf-json-schema",
          "role": "support",
          "why": "A 段载体锚（轮换 0；与主锚异层）",
          "layer": "data",
          "body": "IETF/JSON Schema",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "ietf-json"
          ]
        }
      ],
      "check": "声明 solver（含版本）、dt（时间步长 s）、contact_model 与 stability_check（能量守恒/穿透深度上限）。",
      "pitfall": "时间步长过大导致穿透（结论无效）；求解器版本未记录。"
    },
    {
      "id": "A08-07",
      "name": "世界模型与状态预测",
      "definition": "世界模型与状态预测的口径：状态表示、预测时域与 rollout 误差累积报告。",
      "anchor": "https://arxiv.org/abs/1803.10122",
      "anchor_kind": "paper",
      "anchor_status": 200,
      "standard_ref": "onnx",
      "standard_why": "关键词「模型|推理|量化」命中",
      "standards": [
        {
          "ref": "onnx",
          "role": "primary",
          "why": "关键词「模型|推理|量化」命中",
          "layer": "iface",
          "body": "Linux Foundation",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "protobuf"
          ]
        },
        {
          "ref": "w3c-tabular-data",
          "role": "support",
          "why": "A 段载体锚（轮换 1；与主锚异层）",
          "layer": "data",
          "body": "W3C",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "ietf-bcp47"
          ]
        }
      ],
      "check": "声明 state_repr（字段/维度）、horizon（预测步数）与 rollout_error（分步误差曲线，不只报单步）。",
      "pitfall": "只报一步预测误差；长时域误差发散未报告。"
    },
    {
      "id": "A08-08",
      "name": "SLAM 与定位",
      "definition": "SLAM 与定位的口径：传感器配置、轨迹误差指标（ATE/RPE）与失败场景记录。",
      "anchor": "https://arxiv.org/abs/1502.00956",
      "anchor_kind": "paper",
      "anchor_status": 200,
      "standard_ref": "mlcommons-bench",
      "standard_why": "A 段默认绑定（轮换 1）",
      "standards": [
        {
          "ref": "mlcommons-bench",
          "role": "primary",
          "why": "A 段默认绑定（轮换 1）",
          "layer": "eng",
          "body": "MLCommons",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": []
        },
        {
          "ref": "vega-lite",
          "role": "support",
          "why": "A 段载体锚（轮换 2；与主锚异层）",
          "layer": "form",
          "body": "Vega",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "ietf-json-schema"
          ]
        }
      ],
      "check": "声明 sensors（相机/IMU/LiDAR）、metric（ATE|RPE + 对齐方式）与 failure_cases（动态物体/弱纹理等）。",
      "pitfall": "只在理想序列评测；对齐方式（SE3/Sim3）未声明导致尺度误差被掩盖。"
    },
    {
      "id": "A08-09",
      "name": "数字孪生",
      "definition": "数字孪生的口径：孪生粒度、同步频率与偏差监控指标。",
      "anchor": "https://docs.omniverse.nvidia.com/",
      "anchor_kind": "doc",
      "anchor_status": 200,
      "standard_ref": "onnx",
      "standard_why": "A 段默认绑定（轮换 2）",
      "standards": [
        {
          "ref": "onnx",
          "role": "primary",
          "why": "A 段默认绑定（轮换 2）",
          "layer": "iface",
          "body": "Linux Foundation",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "protobuf"
          ]
        },
        {
          "ref": "mermaid",
          "role": "support",
          "why": "A 段载体锚（轮换 3；与主锚异层）",
          "layer": "form",
          "body": "Mermaid",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": []
        }
      ],
      "check": "声明 twin_granularity（设备/产线/园区）、sync_hz 与 drift_metric（孪生与实测偏差）。",
      "pitfall": "孪生只做静态建模（无同步）；偏差无监控（孪生与实际脱节不可见）。"
    },
