  "subdivisions": [
    {
      "id": "A11-01",
      "name": "文本嵌入模型选型",
      "definition": "文本嵌入模型选型的口径：模型 id 与版本、维度、最大输入长度与多语言覆盖。",
      "anchor": "https://arxiv.org/abs/2212.03533",
      "anchor_kind": "paper",
      "anchor_status": 200,
      "standard_ref": "onnx",
      "standard_why": "关键词「模型|推理|量化」命中",
      "standards": [
        {
          "ref": "onnx",
          "role": "primary",
          "why": "关键词「模型|推理|量化」命中",
          "layer": "iface",
          "body": "Linux Foundation",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "protobuf"
          ]
        },
        {
          "ref": "commonmark",
          "role": "support",
          "why": "载体锚：产出形态「文本」的承载标准",
          "layer": "form",
          "body": "CommonMark",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": []
        }
      ],
      "check": "声明 model_id（含 revision）、dim、max_tokens 与 langs（是否多语言），四项齐备方可比较。",
      "pitfall": "只写模型名不给 revision（同一名字权重已变）；最大输入长度不同却直接比检索分。"
    },
    {
      "id": "A11-02",
      "name": "稀疏与稠密混合检索",
      "definition": "稀疏与稠密混合检索的口径：混合方式（并集 / 加权 / RRF）、权重与归一化。",
      "anchor": "https://arxiv.org/abs/2210.11934",
      "anchor_kind": "paper",
      "anchor_status": 200,
      "standard_ref": "frictionless-package",
      "standard_why": "关键词「检索|向量|嵌入|召回」命中",
      "standards": [
        {
          "ref": "frictionless-package",
          "role": "primary",
          "why": "关键词「检索|向量|嵌入|召回」命中",
          "layer": "data",
          "body": "Frictionless",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "ietf-json-schema"
          ]
        },
        {
          "ref": "vega-lite",
          "role": "support",
          "why": "A 段载体锚（轮换 2；与主锚异层）",
          "layer": "form",
          "body": "Vega",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "ietf-json-schema"
          ]
        }
      ],
      "check": "声明 fusion（rrf|weighted|union）、weights（数值）与 score_norm（min-max|z-score|none）。",
      "pitfall": "分数未归一化就加权（BM25 与余弦量纲不同）；融合方式未声明导致不可复现。"
    },
    {
      "id": "A11-03",
      "name": "重排序模型",
      "definition": "重排序模型的口径：候选规模、重排深度与延迟预算。",
      "anchor": "https://arxiv.org/abs/1908.10084",
      "anchor_kind": "paper",
      "anchor_status": 200,
      "standard_ref": "onnx",
      "standard_why": "关键词「模型|推理|量化」命中",
      "standards": [
        {
          "ref": "onnx",
          "role": "primary",
          "why": "关键词「模型|推理|量化」命中",
          "layer": "iface",
          "body": "Linux Foundation",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "protobuf"
          ]
        },
        {
          "ref": "vega-lite",
          "role": "support",
          "why": "A 段载体锚（轮换 2；与主锚异层）",
          "layer": "form",
          "body": "Vega",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "ietf-json-schema"
          ]
        }
      ],
      "check": "声明 candidates（进入重排的候选数）、rerank_depth（最终截断）与 latency_budget_ms。",
      "pitfall": "候选规模与重排深度未声明导致跨系统不可比；延迟预算缺失导致线上不可用。"
    },
    {
      "id": "A11-04",
      "name": "向量维度与压缩",
      "definition": "向量维度与压缩的口径：降维 / 量化方式、召回损失与存储成本对照。",
      "anchor": "https://arxiv.org/abs/1702.08734",
      "anchor_kind": "paper",
      "anchor_status": 200,
      "standard_ref": "frictionless-package",
      "standard_why": "关键词「检索|向量|嵌入|召回」命中",
      "standards": [
        {
          "ref": "frictionless-package",
          "role": "primary",
          "why": "关键词「检索|向量|嵌入|召回」命中",
          "layer": "data",
          "body": "Frictionless",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "ietf-json-schema"
          ]
        },
        {
          "ref": "mermaid",
          "role": "support",
          "why": "A 段载体锚（轮换 3；与主锚异层）",
          "layer": "form",
          "body": "Mermaid",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": []
        }
      ],
      "check": "声明 compression（none|PQ|OPQ|int8）、target_dim 与 recall_loss（对照全维度的召回差）。",
      "pitfall": "只报存储节省不报召回损失；量化参数未记录导致不可复现。"
    },
    {
      "id": "A11-05",
      "name": "相似度度量与归一化",
      "definition": "相似度度量与归一化的口径：度量选择（余弦 / 内积 / 欧氏）、是否归一化与距离变换。",
      "anchor": "https://scikit-learn.org/stable/modules/metrics.html",
      "anchor_kind": "doc",
      "anchor_status": 200,
      "standard_ref": "arrow",
      "standard_why": "域码 A11 专属绑定（轮换 0）",
      "standards": [
        {
          "ref": "arrow",
          "role": "primary",
          "why": "域码 A11 专属绑定（轮换 0）",
          "layer": "data",
          "body": "Apache",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": []
        },
        {
          "ref": "w3c-prov-o",
          "role": "support",
          "why": "A 段载体锚（轮换 4；与主锚异层）",
          "layer": "gov",
          "body": "W3C",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "rdf11"
          ]
        }
      ],
      "check": "声明 metric（cosine|ip|l2）、normalized（true|false）与 distance_transform（若将距离当分数）。",
      "pitfall": "内积与余弦混淆（未归一化时结果不同）；距离未做单调变换导致排序反转。"
    },
    {
      "id": "A11-06",
      "name": "多语言嵌入",
