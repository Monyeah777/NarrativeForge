          "why": "关键词「检索|向量|嵌入|召回」命中",
          "layer": "data",
          "body": "Frictionless",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "ietf-json-schema"
          ]
        },
        {
          "ref": "vega-lite",
          "role": "support",
          "why": "A 段载体锚（轮换 2；与主锚异层）",
          "layer": "form",
