{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "组合包借阅索引",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "package",
    "borrowed"
  ],
  "properties": {
    "schema": {
      "const": "nf-combo-borrow/1"
    },
    "package": {
      "type": "string",
      "minLength": 2
    },
    "note": {
      "type": "string"
    },
    "borrowed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_package",
          "modules",
          "mode"
        ],
        "properties": {
          "source_package": {
            "type": "string",
            "minLength": 2
          },
          "modules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "mode": {
            "const": "asset_readonly"
          }
        }
      }
    }
  }
}
