  "subdivisions": [
    {
      "id": "A07-01",
      "name": "扩散模型与采样器",
      "definition": "扩散模型与采样器的口径：噪声调度、采样步数、引导强度与随机种子策略。",
      "anchor": "https://arxiv.org/abs/2006.11239",
      "anchor_kind": "paper",
      "anchor_status": 200,
      "standard_ref": "onnx",
      "standard_why": "关键词「模型|推理|量化」命中",
      "standards": [
        {
          "ref": "onnx",
          "role": "primary",
          "why": "关键词「模型|推理|量化」命中",
          "layer": "iface",
          "body": "Linux Foundation",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "protobuf"
          ]
        },
        {
          "ref": "ietf-json-schema",
          "role": "support",
          "why": "A 段载体锚（轮换 0；与主锚异层）",
          "layer": "data",
          "body": "IETF/JSON Schema",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "ietf-json"
          ]
        }
      ],
      "check": "声明 noise_schedule（linear|cosine）、sample_steps、guidance_scale（数值）与 seed 策略（固定|随机 + 次数）。",
      "pitfall": "不同采样步数直接比画质；只报单张最好结果不报种子方差。"
    },
    {
      "id": "A07-02",
      "name": "流匹配与整流流",
      "definition": "流匹配与整流流的训练口径：路径构造、时间采样分布与 ODE 求解器。",
      "anchor": "https://arxiv.org/abs/2210.02747",
      "anchor_kind": "paper",
      "anchor_status": 200,
      "standard_ref": "mlcommons-bench",
      "standard_why": "A 段默认绑定（轮换 1）",
      "standards": [
        {
          "ref": "mlcommons-bench",
          "role": "primary",
          "why": "A 段默认绑定（轮换 1）",
          "layer": "eng",
          "body": "MLCommons",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": []
        },
        {
          "ref": "cncf-cloudevents",
          "role": "support",
          "why": "载体锚：产出形态「事件」的承载标准",
          "layer": "iface",
          "body": "CNCF",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "ietf-json-schema"
          ]
        }
      ],
      "check": "声明 path（linear|cosine）、t_sampling（uniform|logit-normal）、solver（euler|heun）+ 步数。",
      "pitfall": "求解器与步数不同却比较生成质量；路径定义未记录导致训练不可复现。"
    },
    {
      "id": "A07-03",
      "name": "结构条件控制",
      "definition": "结构条件控制的口径：条件模态（边缘 / 深度 / 姿态 / 分割）、控制强度与条件保真度。",
      "anchor": "https://arxiv.org/abs/2302.05543",
      "anchor_kind": "paper",
      "anchor_status": 200,
      "standard_ref": "onnx",
      "standard_why": "A 段默认绑定（轮换 2）",
      "standards": [
        {
          "ref": "onnx",
          "role": "primary",
          "why": "A 段默认绑定（轮换 2）",
          "layer": "iface",
          "body": "Linux Foundation",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "protobuf"
          ]
        },
        {
          "ref": "vega-lite",
          "role": "support",
          "why": "A 段载体锚（轮换 2；与主锚异层）",
          "layer": "form",
          "body": "Vega",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "ietf-json-schema"
          ]
        }
      ],
      "check": "声明 condition_modality（枚举）、control_weight（0–1）与条件保真度指标（如 F1 of edges）。",
      "pitfall": "只报美观不报结构遵循度；控制权重未声明导致复现不出同一结果。"
    },
    {
      "id": "A07-04",
      "name": "图像修复与扩图",
      "definition": "图像修复与扩图的口径：掩码生成方式、外扩比例与边界一致性要求。",
      "anchor": "https://arxiv.org/abs/2109.07161",
      "anchor_kind": "paper",
      "anchor_status": 200,
      "standard_ref": "w3c-svg2",
      "standard_why": "关键词「图像|视觉|扩散|超分|抠图」命中",
      "standards": [
        {
          "ref": "w3c-svg2",
          "role": "primary",
          "why": "关键词「图像|视觉|扩散|超分|抠图」命中",
          "layer": "form",
          "body": "W3C",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "w3c-xml"
          ]
        },
        {
          "ref": "vega-lite",
          "role": "support",
          "why": "载体锚：产出形态「图」的承载标准",
          "layer": "form",
          "body": "Vega",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "ietf-json-schema"
          ]
        }
      ],
      "check": "声明 mask_source（手工|自动）、outpaint_ratio（外扩比例）与 boundary_metric（边界一致性指标）。",
      "pitfall": "掩码过小导致任务过易（虚高）；扩图边界接缝未评测。"
    },
    {
      "id": "A07-05",
      "name": "风格化与风格迁移",
      "definition": "风格化与风格迁移的口径：风格参考数量、内容保真度与风格强度控制。",
      "anchor": "https://arxiv.org/abs/1703.06868",
      "anchor_kind": "paper",
      "anchor_status": 200,
      "standard_ref": "mlcommons-bench",
      "standard_why": "A 段默认绑定（轮换 1）",
      "standards": [
        {
          "ref": "mlcommons-bench",
          "role": "primary",
          "why": "A 段默认绑定（轮换 1）",
          "layer": "eng",
          "body": "MLCommons",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": []
        },
        {
          "ref": "w3c-prov-o",
          "role": "support",
          "why": "A 段载体锚（轮换 4；与主锚异层）",
          "layer": "gov",
          "body": "W3C",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "rdf11"
          ]
        }
      ],
      "check": "声明 style_refs（数量）、content_fidelity（指标 + 阈值）与 style_strength（0–1 或枚举）。",
      "pitfall": "只报风格相似不报内容保持；风格强度未声明导致对比不公平。"
    },
    {
      "id": "A07-06",
      "name": "超分与画质增强",
      "definition": "超分与画质增强的口径：退化模型、放大倍数与感知 / 保真双指标。",
      "anchor": "https://arxiv.org/abs/2107.10833",
      "anchor_kind": "paper",
      "anchor_status": 200,
      "standard_ref": "w3c-svg2",
      "standard_why": "关键词「图像|视觉|扩散|超分|抠图」命中",
      "standards": [
        {
          "ref": "w3c-svg2",
          "role": "primary",
          "why": "关键词「图像|视觉|扩散|超分|抠图」命中",
          "layer": "form",
          "body": "W3C",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "w3c-xml"
          ]
        },
        {
          "ref": "ietf-json-schema",
          "role": "support",
          "why": "A 段载体锚（轮换 0；与主锚异层）",
          "layer": "data",
          "body": "IETF/JSON Schema",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "ietf-json"
          ]
        }
      ],
      "check": "声明 degradation_model、scale_factor 与双指标（PSNR/SSIM + LPIPS 或 NIQE）。",
      "pitfall": "只报 PSNR 掩盖过度平滑；退化模型与实际不符导致结论不可迁移。"
    },
    {
      "id": "A07-07",
      "name": "背景替换与抠图",
      "definition": "背景替换与抠图的口径：alpha 边缘质量、半透明区域处理与合成光照一致性。",
      "anchor": "https://arxiv.org/abs/2011.11961",
      "anchor_kind": "paper",
      "anchor_status": 200,
      "standard_ref": "w3c-svg2",
      "standard_why": "关键词「图像|视觉|扩散|超分|抠图」命中",
      "standards": [
        {
          "ref": "w3c-svg2",
          "role": "primary",
          "why": "关键词「图像|视觉|扩散|超分|抠图」命中",
          "layer": "form",
          "body": "W3C",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "w3c-xml"
          ]
        },
        {
          "ref": "vega-lite",
          "role": "support",
          "why": "载体锚：产出形态「图」的承载标准",
          "layer": "form",
          "body": "Vega",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "ietf-json-schema"
          ]
        }
      ],
      "check": "声明 alpha_metric（MAD|MSE|Gradient）、semi_transparent（handled|ignored）与 relight（true|false）。",
      "pitfall": "只测不透明区域（发丝与半透明处忽略）；合成后光照不一致未评测。"
    },
    {
      "id": "A07-08",
      "name": "人像美化与换脸边界",
      "definition": "人像美化与换脸边界：可做 / 不可做清单、同意与可追溯要求。",
      "anchor": "https://arxiv.org/abs/1901.08971",
      "anchor_kind": "paper",
      "anchor_status": 200,
      "standard_ref": "mlcommons-bench",
      "standard_why": "A 段默认绑定（轮换 1）",
      "standards": [
        {
          "ref": "mlcommons-bench",
          "role": "primary",
          "why": "A 段默认绑定（轮换 1）",
          "layer": "eng",
          "body": "MLCommons",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": []
        },
        {
          "ref": "vega-lite",
          "role": "support",
          "why": "A 段载体锚（轮换 2；与主锚异层）",
          "layer": "form",
          "body": "Vega",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "ietf-json-schema"
          ]
        }
      ],
      "check": "必须给出 allowed_ops 与 forbidden_ops 两张清单 + consent_required（true）+ traceability（输入输出指纹口径）。",
      "pitfall": "默认同意缺失（无授权换脸）；无输入输出指纹导致不可追责。"
    },
    {
      "id": "A07-09",
      "name": "LoRA 与个性化微调",
      "definition": "LoRA 与个性化微调的口径：训练集规模、秩与学习率、以及过拟合判定。",
      "anchor": "https://arxiv.org/abs/2106.09685",
      "anchor_kind": "paper",
      "anchor_status": 200,
      "standard_ref": "mlcommons-bench",
      "standard_why": "关键词「训练|微调|对齐|蒸馏|偏好」命中",
      "standards": [
        {
          "ref": "mlcommons-bench",
          "role": "primary",
          "why": "关键词「训练|微调|对齐|蒸馏|偏好」命中",
          "layer": "eng",
          "body": "MLCommons",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": []
        },
        {
          "ref": "mermaid",
          "role": "support",
          "why": "A 段载体锚（轮换 3；与主锚异层）",
          "layer": "form",
          "body": "Mermaid",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": []
        }
      ],
      "check": "声明 train_set_size、rank（r）、lr 与 overfit_check（留出集 + 阈值）。",
      "pitfall": "用训练图自测（必然「像」）；秩与学习率未记录导致无法复现。"
    },
    {
      "id": "A07-10",
      "name": "提示词与美学控制",
      "definition": "提示词与美学控制的口径：提示结构、负向提示与美学评分来源。",
      "anchor": "https://arxiv.org/abs/2207.12598",
      "anchor_kind": "paper",
      "anchor_status": 200,
      "standard_ref": "commonmark",
      "standard_why": "关键词「提示|指令|模板」命中",
      "standards": [
        {
          "ref": "commonmark",
          "role": "primary",
          "why": "关键词「提示|指令|模板」命中",
          "layer": "form",
          "body": "CommonMark",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": []
        },
        {
          "ref": "w3c-prov-o",
          "role": "support",
          "why": "A 段载体锚（轮换 4；与主锚异层）",
          "layer": "gov",
          "body": "W3C",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "rdf11"
          ]
        }
      ],
      "check": "声明 prompt_template（结构）、negative_prompt（是否使用）与 aesthetic_score（模型 id + 版本或人工量表）。",
      "pitfall": "用模型自己打的美学分当人类偏好；提示模板未固定导致跨报告不可比。"
    },
    {
      "id": "A07-11",
      "name": "生成水印与溯源",
      "definition": "生成水印与溯源的口径：水印方法、鲁棒性测试条件与溯源清单形态。",
      "anchor": "https://c2pa.org/specifications/specifications/1.3/index.html",
      "anchor_kind": "spec",
      "anchor_status": 200,
      "standard_ref": "c2pa-spec",
      "standard_why": "关键词「水印|溯源|凭证|内容来源」命中",
      "standards": [
        {
          "ref": "c2pa-spec",
          "role": "primary",
          "why": "关键词「水印|溯源|凭证|内容来源」命中",
          "layer": "gov",
          "body": "C2PA",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "cbor",
            "cose"
          ]
        },
        {
          "ref": "w3c-prov-o",
          "role": "support",
