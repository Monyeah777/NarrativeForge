    },
    {
      "id": "A07-12",
      "name": "生成质量评测",
      "definition": "生成质量评测的口径：分布级指标（FID）、文本一致性与人工偏好三分量。",
      "anchor": "https://arxiv.org/abs/1706.08500",
      "anchor_kind": "paper",
      "anchor_status": 200,
      "standard_ref": "mlcommons-bench",
      "standard_why": "关键词「评测|基准|排行榜|跑分」命中",
      "standards": [
        {
          "ref": "mlcommons-bench",
          "role": "primary",
          "why": "关键词「评测|基准|排行榜|跑分」命中",
          "layer": "eng",
          "body": "MLCommons",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": []
        },
        {
          "ref": "w3c-tabular-data",
          "role": "support",
          "why": "A 段载体锚（轮换 1；与主锚异层）",
          "layer": "data",
          "body": "W3C",
          "reachable": true,
          "http_status": 200,
