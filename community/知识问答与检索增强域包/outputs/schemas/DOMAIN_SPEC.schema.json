{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrativeforge.local/schema/domain-spec-b06.schema.json",
  "title": "知识问答与检索增强 域口径表（机读投影）",
  "description": "assets/DOMAIN_SPEC.md 的机读投影契约；键集须与散文面双向一致（双源一致由 check32 output_forms 断言）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "code",
    "domain",
    "section",
    "anchors_verified_on",
    "standard_anchors_verified_on",
    "metric_family",
    "subdivisions",
    "content_tier",
    "data_authenticity"
  ],
  "properties": {
    "kind": {
      "const": "nf-domain-spec/1"
    },
    "content_tier": {
      "enum": [
        "authored",
        "derived"
      ]
    },
    "code": {
      "const": "B06"
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "section": {
      "type": "string",
      "minLength": 1
    },
    "anchors_verified_on": {
      "type": "string",
      "format": "date"
    },
    "standard_anchors_verified_on": {
      "type": "string",
      "minLength": 4
    },
    "metric_family": {
      "type": "string",
      "minLength": 3
    },
    "data_authenticity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard_bindings",
        "in_catalog_ratio",
        "reachable_ratio",
        "probe_evidence_ratio",
        "anchor_probed_ratio",
        "score",
        "threshold",
        "bound_standards"
      ],
      "properties": {
        "standard_bindings": {
          "type": "integer",
          "minimum": 1
        },
        "in_catalog_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reachable_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "probe_evidence_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "anchor_probed_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bound_standards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    },
    "subdivisions": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "definition",
          "anchor",
          "anchor_kind",
          "anchor_status",
          "standard_ref",
          "standard_why",
          "standards",
          "check",
          "pitfall"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^B06-[0-9]{2}$"
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "definition": {
            "type": "string",
            "minLength": 8
          },
          "anchor": {
            "type": "string",
            "format": "uri"
          },
          "anchor_kind": {
            "enum": [
              "spec",
              "paper",
              "repo",
              "doc",
              "dataset"
            ]
          },
          "anchor_status": {
            "type": "integer",
            "minimum": 0
          },
          "standard_ref": {
            "type": "string",
            "minLength": 2
          },
          "standard_why": {
            "type": "string",
            "minLength": 3
          },
          "standards": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ref",
                "role",
                "why",
                "layer",
                "body",
                "reachable",
                "http_status",
                "probe_date",
                "depends_on"
              ],
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 2
                },
                "role": {
                  "enum": [
                    "primary",
                    "support"
                  ]
                },
                "why": {
                  "type": "string",
                  "minLength": 3
                },
                "layer": {
                  "enum": [
                    "data",
                    "iface",
                    "form",
                    "gov",
                    "eng"
                  ]
                },
                "body": {
                  "type": "string",
                  "minLength": 1
                },
                "reachable": {
                  "type": "boolean"
                },
                "http_status": {
                  "type": "integer",
                  "minimum": 0
                },
                "probe_date": {
                  "type": "string",
                  "minLength": 4
                },
                "depends_on": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 2
                  }
                }
              }
            }
          },
          "check": {
            "type": "string",
            "minLength": 10
          },
          "pitfall": {
            "type": "string",
            "minLength": 6
          }
        }
      }
    }
  }
}
