          "ref": "mlcommons-bench",
          "role": "primary",
          "why": "关键词「评测|基准|排行榜|跑分」命中",
          "layer": "eng",
          "body": "MLCommons",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": []
        },
        {
          "ref": "w3c-tabular-data",
