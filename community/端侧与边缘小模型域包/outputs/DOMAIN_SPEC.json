          "why": "关键词「隐私|个人信息|去标识|合规|监管」命中",
          "layer": "gov",
          "body": "EU",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": []
        },
        {
          "ref": "ietf-json-schema",
          "role": "support",
          "why": "A 段载体锚（轮换 0；与主锚异层）",
          "layer": "data",
          "body": "IETF/JSON Schema",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
