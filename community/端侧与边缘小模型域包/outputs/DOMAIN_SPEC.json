  "subdivisions": [
    {
      "id": "A14-01",
      "name": "小模型蒸馏与裁剪",
      "definition": "小模型蒸馏与裁剪的口径：教师 / 学生规模、蒸馏目标与剪裁后精度落差。",
      "anchor": "https://arxiv.org/abs/1910.01108",
      "anchor_kind": "paper",
      "anchor_status": 200,
      "standard_ref": "onnx",
      "standard_why": "关键词「模型|推理|量化」命中",
      "standards": [
        {
          "ref": "onnx",
          "role": "primary",
          "why": "关键词「模型|推理|量化」命中",
          "layer": "iface",
          "body": "Linux Foundation",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "protobuf"
          ]
        },
        {
          "ref": "ietf-json-schema",
          "role": "support",
          "why": "A 段载体锚（轮换 0；与主锚异层）",
          "layer": "data",
          "body": "IETF/JSON Schema",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "ietf-json"
          ]
        }
      ],
      "check": "声明 teacher/student（参数量）、distill_target（logits|hidden|sequence）与 accuracy_drop（相对基线落差）。",
      "pitfall": "只报学生模型绝对分不给落差；蒸馏数据与评测集重叠。"
    },
    {
      "id": "A14-02",
      "name": "模型量化压缩部署",
      "definition": "模型量化压缩部署的口径：量化位宽 / 分组、校准集来源与精度-延迟双指标。",
      "anchor": "https://arxiv.org/abs/2208.07339",
      "anchor_kind": "paper",
      "anchor_status": 200,
      "standard_ref": "oasis-openapi",
      "standard_why": "关键词「接口|API|端点|服务|部署」命中",
      "standards": [
        {
          "ref": "oasis-openapi",
          "role": "primary",
          "why": "关键词「接口|API|端点|服务|部署」命中",
          "layer": "iface",
          "body": "OpenAPI Initiative",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "ietf-json-schema"
          ]
        },
        {
          "ref": "w3c-tabular-data",
          "role": "support",
          "why": "A 段载体锚（轮换 1；与主锚异层）",
          "layer": "data",
          "body": "W3C",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "ietf-bcp47"
          ]
        }
      ],
      "check": "声明 bits（8|4|2）、group_size、calib_set（来源 + 样本数）与 metric_pair（精度 + 首 token 延迟）。",
      "pitfall": "只报体积缩小；校准集与测试集同源（虚高）。"
    },
    {
      "id": "A14-03",
      "name": "端侧推理框架",
      "definition": "端侧推理框架的口径：运行时与版本、算子覆盖、后端（CPU/GPU/NPU）与线程数。",
      "anchor": "https://onnxruntime.ai/docs/",
      "anchor_kind": "doc",
      "anchor_status": 200,
      "standard_ref": "onnx",
      "standard_why": "关键词「模型|推理|量化」命中",
      "standards": [
        {
          "ref": "onnx",
          "role": "primary",
          "why": "关键词「模型|推理|量化」命中",
          "layer": "iface",
          "body": "Linux Foundation",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "protobuf"
          ]
        },
        {
          "ref": "vega-lite",
          "role": "support",
          "why": "A 段载体锚（轮换 2；与主锚异层）",
          "layer": "form",
          "body": "Vega",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": [
            "ietf-json-schema"
          ]
        }
      ],
      "check": "声明 runtime（onnxruntime/tflite/mnn 等 + 版本）、backend、threads 与 op_coverage（不支持的算子数与回退策略）。",
      "pitfall": "换后端直接比延迟（不可比）；算子回退到 CPU 未声明。"
    },
    {
      "id": "A14-04",
      "name": "内存与功耗预算",
      "definition": "内存与功耗预算的口径：峰值内存、常驻内存、单次推理能耗与温控降频处理。",
      "anchor": "https://mlcommons.org/benchmarks/inference-mobile/",
      "anchor_kind": "spec",
      "anchor_status": 200,
      "standard_ref": "ieee-754",
      "standard_why": "域码 A14 专属绑定（轮换 1）",
      "standards": [
        {
          "ref": "ieee-754",
          "role": "primary",
          "why": "域码 A14 专属绑定（轮换 1）",
          "layer": "data",
          "body": "IEEE",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": []
        },
        {
          "ref": "mermaid",
          "role": "support",
          "why": "A 段载体锚（轮换 3；与主锚异层）",
          "layer": "form",
          "body": "Mermaid",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": []
        }
      ],
      "check": "声明 peak_mem_mb、rss_mb、energy_per_inference（mJ 或 %/次）与 throttling_policy（是否排除降频样本）。",
      "pitfall": "只报平均值掩盖温控降频；能耗口径与设备未声明。"
    },
    {
