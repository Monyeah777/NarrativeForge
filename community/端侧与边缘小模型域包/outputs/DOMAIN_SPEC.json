        {
          "ref": "covesa-vss",
          "role": "primary",
          "why": "关键词「交通|出行|车机|车辆|导航」命中",
          "layer": "iface",
          "body": "COVESA",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": []
        },
        {
          "ref": "mermaid",
          "role": "support",
          "why": "A 段载体锚（轮换 3；与主锚异层）",
          "layer": "form",
          "body": "Mermaid",
