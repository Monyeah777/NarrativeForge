      "anchor": "https://arxiv.org/abs/2110.02178",
      "anchor_kind": "paper",
      "anchor_status": 200,
      "standard_ref": "ieee-754",
      "standard_why": "域码 A14 专属绑定（轮换 1）",
      "standards": [
        {
          "ref": "ieee-754",
          "role": "primary",
          "why": "域码 A14 专属绑定（轮换 1）",
          "layer": "data",
          "body": "IEEE",
          "reachable": true,
          "http_status": 200,
          "probe_date": "2026-09-24",
          "depends_on": []
        },
        {
          "ref": "vega-lite",
          "role": "support",
          "why": "A 段载体锚（轮换 2；与主锚异层）",
          "layer": "form",
          "body": "Vega",
          "reachable": true,
