diff --git a/pythonforandroid/recipe.py b/pythonforandroid/recipe.py
index 8808ffc..c64e459 100644
--- a/pythonforandroid/recipe.py
+++ b/pythonforandroid/recipe.py
@@ -1313,7 +1313,7 @@ class PyProjectRecipe(PythonRecipe):
             return
 
         self.install_hostpython_prerequisites(
-            packages=["build[virtualenv]", "pip", "setuptools"] + self.hostpython_prerequisites
+            packages=["build[virtualenv]", "pip", "setuptools", "wheel"] + self.hostpython_prerequisites
         )
         self.patch_shebangs(self._host_recipe.site_bin, self.real_hostpython_location)
 
@@ -1324,9 +1324,47 @@ class PyProjectRecipe(PythonRecipe):
         # copy hostpython to built python to ensure correct selection of libs and includes
         shprint(sh.cp, self.real_hostpython_location, self.ctx.python_recipe.python_exe)
 
+        # Wheel builds run with --no-isolation. `python -m build`'s default
+        # isolated env (venv+pip) is broken on p4a's hostpython3: the fresh
+        # venv never gets a working setuptools (its pip install of the
+        # backend requirements produces no output at all), so sdists with a
+        # [build-system] table fail with:
+        #   BackendUnavailable: Cannot import 'setuptools.build_meta'
+        # Running the backend directly in this env works because PYTHONPATH
+        # already points at hostpython3's site_dir, where
+        # install_hostpython_prerequisites installed setuptools / Cython /
+        # wheel (see packages= above). Sanity-probe that import below so a
+        # regression shows up as a clear message instead of a nested
+        # BackendUnavailable.
+        #
+        # --skip-dependency-check: `python -m build` (PyPA build >= 0.10)
+        # runs a defensive pre-check of the pyproject [build-system]
+        # requires against sys.executable via importlib.metadata. With
+        # --no-isolation that check is redundant (we already run in the
+        # env whose PYTHONPATH/site_dir we just probed) and on p4a it
+        # misfires: importlib.metadata reads the FIRST Cython*.dist-info
+        # in site_dir, and earlier recipes' Cython 3.1.8 install left its
+        # dist-info behind after pip --upgrade --target downgraded the
+        # .py files to 3.0.12 -- so the pre-check reports "found 3.1.8".
+        # Kivy 2.3.0 also declares cython<=3.0.0 (setup.cfg cython_max)
+        # while hostpython_prerequisites installs 3.0.12 for Kivy 2.3.1,
+        # so wanted/found can never match -- yet 3.0.12 builds Kivy fine
+        # ("untested" warning only; egg_info/Building extensions proceed).
+        # Skipping the check loses no real safety and unblocks the build.
+        shprint(
+            sh.Command(self.ctx.python_recipe.python_exe),
+            "-c",
+            "import setuptools, setuptools.build_meta, wheel, Cython; "
+            "print('no-isolation env OK: setuptools', setuptools.__version__, "
+            "'legacy backend:', hasattr(setuptools.build_meta, '__legacy__'))",
+            _env=env,
+        )
+
         build_args = [
             "-m",
             "build",
+            "--no-isolation",
+            "--skip-dependency-check",
             "--wheel",
             "--config-setting",
             "builddir={}".format(sub_build_dir),
