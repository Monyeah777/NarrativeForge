{
  "schema": "nf-net-probe-manifest/1",
  "date": "2026-09-28",
  "purpose": "38 个判据探针的**唯一参数出处**：跑批器 run-probes.ps1 只读本件，不在脚本里硬编码参数，也不靠字符串匹配猜 CLI（第一百零八片那类假红的根因）。",
  "why": "此前每个探针的参数口径只存在于编制者脑内与逐片补记里；把口径写成机读清单，第三方才能一条命令复现全部 38 条判据。",
  "tokens": {
    "{engine}": "引擎工作区根（本仓库所在的 NF-NET-engine）",
    "{snap}": "隔离快照 nf-snap-h5（金标测量基线）",
    "{other}": "对照快照 nf-snap-h6（只作归因用例）",
    "{cli}": "nf-dotnet 可执行体（默认取 dist 下最大 fNN 的当片形态）",
    "{parity}": "nfparity 可执行体（对账工具）",
    "{py}": "CPython 解释器",
    "{dotnet}": ".NET SDK 可执行体（dotnet.exe；可复现构建探针用）",
    "{bash}": "git-bash（真源 check1/check7 与 verify.sh 的 oracle 通道）",
    "{self}": "src/Nf.Engine/SelfTest.cs（--expect-embedded 的机械导出纪律靶件）",
    "{stout}": "probes/_stout（跑批输出与记录件的临时落点，避免覆盖具名记录件）"
  },
  "tiers": {
    "core": "默认跑批集合（每条数十秒到数分钟）",
    "long": "重型集合（需 -Tier all 显式纳入）：两道门同判、规模面、差分模糊、敌意输入"
  },
  "probes": [
    {
      "name": "artifact-equivalence",
      "script": "artifact_equivalence_probe.py",
      "tier": "core",
      "args": ["--bin", "{bin}", "--win", "{win}", "--linux", "{linux}", "--behavior-verified", "bin", "--behavior-verified", "win", "--record", "{stout}/_record_artifact_equivalence.md"],
      "note": "产物一致性；--record 落 _stout，不覆盖具名记录件"
    },
    { "name": "asset", "script": "asset_probe.py", "tier": "core", "args": ["--root", "{snap}", "--cli", "{cli}", "--py-exe", "{py}"] },
    { "name": "asset-quality", "script": "asset_quality_probe.py", "tier": "core", "args": ["--snap", "{snap}", "--cli", "{cli}"] },
    { "name": "closure-depth", "script": "closure_depth_probe.py", "tier": "core", "args": ["--snapshot", "{snap}", "--cli", "{cli}", "--py-exe", "{py}"] },
    { "name": "conformance-negative", "script": "conformance_negative_probe.py", "tier": "core", "args": ["--py-src", "{snap}/desktop/src", "--cli", "{parity}"], "note": "用 nfparity；--py-src 必须显式给（其 DEFAULT_PY_SRC 仍指向已停用的 nf-snap-head）" },
    { "name": "corpus-stamp", "script": "corpus_stamp_probe.py", "tier": "core", "args": ["--snap", "{snap}", "--other", "{other}", "--cli", "{cli}"] },
    { "name": "bundle-integrity", "script": "bundle_integrity_probe.py", "tier": "core", "args": ["--engine", "{engine}", "--snap", "{snap}", "--cli", "{cli}"], "note": "入库包体检：包内卫生（LF/BOM/缓存目录/作者路径）· workflow YAML 与平台面 · ADR 结构与 INDEX 投影 · 清单一致 · 包内文档数字=实测（--bundle 缺省取引擎工作区同级的 NF_NET入库包_v1）" },
    { "name": "cli-surface", "script": "cli_surface_probe.py", "tier": "core", "args": ["--engine", "{engine}", "--cli", "{cli}"], "note": "CLI 面可达：`--help` 命令表 ⊇ Program.cs 分派面（含幽灵命令检测）" },
    { "name": "decision-layer", "script": "decision_layer_probe.py", "tier": "core", "args": ["--snap", "{snap}", "--cli", "{cli}", "--expect-embedded", "{self}"] },
    { "name": "deepening-gate", "script": "deepening_gate_probe.py", "tier": "core", "args": ["--snap", "{snap}", "--cli", "{cli}", "--expect-embedded", "{self}"] },
    { "name": "differential-fuzz", "script": "differential_fuzz_probe.py", "tier": "long", "args": ["--root", "{snap}", "--py-src", "{snap}/desktop/src", "--cli", "{parity}"] },
    { "name": "doc-completeness", "script": "doc_completeness_probe.py", "tier": "core", "args": ["--snap", "{snap}", "--cli", "{cli}"] },
    { "name": "domain-closure", "script": "domain_closure_probe.py", "tier": "core", "args": ["--snap", "{snap}", "--cli", "{cli}"] },
    { "name": "exit-faces", "script": "exit_faces_probe.py", "tier": "core", "args": ["--snap", "{snap}", "--cli", "{cli}", "--expect-embedded", "{self}"] },
    { "name": "extension-policy", "script": "extension_policy_probe.py", "tier": "core", "args": ["--snap", "{snap}", "--cli", "{cli}", "--expect-embedded", "{self}"] },
    { "name": "face-parity", "script": "face_parity_probe.py", "tier": "core", "args": ["--root", "{snap}", "--py-exe", "{py}", "--cli", "{cli}"] },
    { "name": "fde-sample", "script": "fde_sample_probe.py", "tier": "core", "args": ["--snap", "{snap}", "--cli", "{cli}", "--expect-embedded", "{self}"] },
    { "name": "geo-export", "script": "geo_export_probe.py", "tier": "core", "args": ["--snap", "{snap}", "--cli", "{cli}", "--expect-embedded", "{self}"] },
    { "name": "handoff-integrity", "script": "handoff_integrity_probe.py", "tier": "core", "args": ["--snap", "{snap}", "--cli", "{cli}"] },
    { "name": "hostile-input", "script": "hostile_input_probe.py", "tier": "long", "args": ["--cli", "{cli}", "--parity", "{parity}", "--py-src", "{snap}/desktop/src", "--py-exe", "{py}"] },
    { "name": "impact", "script": "impact_probe.py", "tier": "core", "args": ["--root", "{snap}", "--cli", "{cli}", "--py-exe", "{py}"] },
    { "name": "interop", "script": "interop_probe.py", "tier": "core", "args": ["--root", "{snap}", "--cli", "{cli}"] },
    { "name": "library-receipts", "script": "library_receipts_probe.py", "tier": "core", "args": ["--snap", "{snap}", "--cli", "{cli}", "--expect-embedded", "{self}"] },
    { "name": "license-gate", "script": "license_gate_probe.py", "tier": "core", "args": ["--snap", "{snap}", "--cli", "{cli}", "--expect-embedded", "{self}"] },
    { "name": "market", "script": "market_probe.py", "tier": "core", "args": ["--root", "{snap}", "--cli", "{cli}", "--py-exe", "{py}"] },
    { "name": "mcp-surface", "script": "mcp_surface_probe.py", "tier": "core", "args": ["--cli", "{cli}", "--root", "{snap}"] },
    { "name": "no-regression", "script": "no_regression_probe.py", "tier": "core", "args": ["--engine", "{engine}", "--snap", "{snap}", "--cli", "{cli}"], "note": "不倒退判据：已移植契约集合 / 未移植集合 / 自检例数 / 探针条数 / 对账面数对基线只增不减；自带「抬高基线必须判红」自证" },
    { "name": "no-python-smoke", "script": "no_python_smoke_probe.py", "tier": "core", "args": ["--snap", "{snap}", "--cli", "{cli}", "--engine-root", "{engine}", "--record", "{stout}/_record_no_python_smoke.md"], "note": "--record 落 _stout，不覆盖具名记录件" },
    { "name": "nuget-package-consumer", "script": "nuget_package_consumer_probe.py", "tier": "core", "args": ["--engine", "{engine}", "--snap", "{snap}", "--cli", "{cli}", "--dotnet", "{dotnet}", "--win", "{win}", "--linux", "{linux}"], "note": "打包 + 第三方只引包消费 + API 面冻结 + 负对照；交付形态目录按 token 传，不写死 fNN" },
    { "name": "output-forms", "script": "output_forms_probe.py", "tier": "core", "args": ["--snap", "{snap}", "--cli", "{cli}"] },
    { "name": "prose-lint", "script": "prose_lint_probe.py", "tier": "core", "args": ["--snap", "{snap}", "--cli", "{cli}", "--expect-embedded", "{self}"] },
    { "name": "regression-score", "script": "regression_score_probe.py", "tier": "core", "args": ["--snap", "{snap}", "--cli", "{cli}", "--expect-embedded", "{self}"] },
    { "name": "readonly-invariant", "script": "readonly_invariant_probe.py", "tier": "core", "args": ["--snap", "{snap}", "--cli", "{cli}", "--py-exe", "{py}", "--engine", "{engine}"], "note": "系统级只读不变量：读面零改动 + 写面全拒不偷写 + 显式落盘只落根外 + 负对照会红" },
    { "name": "reproducible-build", "script": "reproducible_build_probe.py", "tier": "long", "args": ["--engine", "{engine}", "--dotnet", "{dotnet}", "--cross-rid"], "note": "两次异地发布 + 负对照（关掉 PathMap 必须变红）" },
    { "name": "scale-control", "script": "scale_control_probe.py", "tier": "long", "args": ["--snapshot", "{snap}", "--cli", "{cli}"] },
    { "name": "scale", "script": "scale_probe.py", "tier": "long", "args": ["--snapshot", "{snap}", "--cli", "{cli}", "--parity", "{parity}"] },
    { "name": "shell-check", "script": "shell_check_probe.py", "tier": "core", "args": ["--snap", "{snap}", "--bash", "{bash}", "--cli", "{cli}"] },
    { "name": "small-faces", "script": "small_faces_probe.py", "tier": "core", "args": ["--snap", "{snap}", "--cli", "{cli}"] },
    { "name": "strict-coherence", "script": "strict_coherence_probe.py", "tier": "core", "args": ["--snapshot", "{snap}", "--cli", "{cli}"] },
    { "name": "stability", "script": "stability_probe.py", "tier": "core", "args": ["--snap", "{snap}", "--cli", "{cli}", "--py-exe", "{py}"], "note": "抖动判据：同一命令重复 3 次逐字节一致（含历史瞬态 decide-dry-run-json 两侧各 3 次）· 负对照 bench 必须变" },
    { "name": "text-hygiene", "script": "text_hygiene_probe.py", "tier": "core", "args": ["--snap", "{snap}", "--cli", "{cli}", "--expect-embedded", "{self}"] },
    { "name": "two-gate-agreement", "script": "two_gate_agreement_probe.py", "tier": "long", "args": ["--snap", "{snap}", "--cli", "{cli}", "--bash", "{bash}", "--py-exe", "{py}", "--with-faces", "--record", "{stout}/_record_two_gate_agreement.md"], "note": "真源 verify.sh 全量跑约 19 分钟，故列入 heavy 集合；--record 落 _stout，不覆盖具名记录件（补齐漏配：本条此前是唯一没有重定向的条目）" },
    { "name": "workloop", "script": "workloop_probe.py", "tier": "core", "args": ["--snap", "{snap}", "--cli", "{cli}", "--expect-embedded", "{self}"] },
    { "name": "worldmodel", "script": "worldmodel_probe.py", "tier": "core", "args": ["--root", "{snap}", "--cli", "{cli}", "--py-exe", "{py}"] },
    { "name": "yaml-typing", "script": "yaml_typing_probe.py", "tier": "core", "args": ["--root", "{snap}", "--cli", "{parity}"], "note": "用 nfparity" }
  ]
}
