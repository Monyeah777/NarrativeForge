{
  "name": "narrativeforge",
  "version": "1.0.0",
  "description": "Content contract layer for AI long-form output: plain-markdown protocol, deterministic gates, verifiable artifacts. One-click launcher for the NF CLI (offline, MIT).",
  "keywords": [
    "narrativeforge",
    "nf",
    "content-contract-layer",
    "llm",
    "long-form",
    "prompt-engineering",
    "spec-driven-content",
    "mcp",
    "geo",
    "ai-agents",
    "markdown",
    "verification",
    "merkle",
    "reproducible"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "bin": {
    "nf": "bin/nf.mjs",
    "narrativeforge": "bin/nf.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "payload/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Monyeah777/NarrativeForge.git",
    "directory": "packaging/npm"
  },
  "homepage": "https://github.com/Monyeah777/NarrativeForge",
  "bugs": {
    "url": "https://github.com/Monyeah777/NarrativeForge/issues"
  },
  "author": "NarrativeForge",
  "sideEffects": false,
  "config": {
    "payload_budget_mb": 14,
    "requires_python": "3.11"
  },
  "scripts": {
    "stage": "node tools/stage-payload.mjs",
    "verify": "node tools/verify-package.mjs",
    "prepack": "node tools/stage-payload.mjs && node tools/verify-package.mjs",
    "test": "node --test test/smoke.test.mjs",
    "smoke": "node tools/stage-payload.mjs && node bin/nf.mjs --version && node bin/nf.mjs doctor"
  }
}
