{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Monyeah777/ninfenz",
  "title": "NinFenz Content Gate",
  "description": "Content contract layer: read-only retrieval over protocol, modules, pipelines, assets, library.",
  "version": "1.0.0",
  "websiteUrl": "https://ninfenz.dev/",
  "repository": {
    "url": "https://github.com/Monyeah777/NinFenz",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "ninfenz",
      "version": "1.0.0",
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "-y"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/Monyeah777/NinFenz/main/packaging/mcp/assets/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ]
}
