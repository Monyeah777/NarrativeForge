# Cloudflare Workers 静态资产自定义响应头（_headers）
# 规则：块首行是路径/模式，随后缩进写 头名: 值

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# 演示与预览图：内容寻址式，长缓存
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML：不缓存，保证改版立即生效
# Vary: Accept —— 首页支持机器面内容协商（Accept: text/markdown -> /llms-full.txt）
/
  Cache-Control: public, max-age=0, must-revalidate
  Vary: Accept
  Link: </llms.txt>; rel="describedby"; type="text/plain"
/en/
  Cache-Control: public, max-age=0, must-revalidate
  Vary: Accept
  Link: </llms.txt>; rel="describedby"; type="text/plain"
/use/
  Cache-Control: public, max-age=0, must-revalidate
/en/use/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# 机器面：给 AI 客户端与 agent 直取 —— 短缓存 + 明确类型 + 允许跨域
# （浏览器内的 AI 客户端要 CORS；明确 Content-Type 免得客户端按二进制处理）
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *
/nf.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *
/agent.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *
/facts.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *
/run.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *

# 爬虫文件：短缓存，便于改名/改版后快速生效
/robots.txt
  Cache-Control: public, max-age=300
/sitemap.xml
  Cache-Control: public, max-age=300
